<html>
<head>
    <title>Jai Shree Krishna</title>

    <style>
        body {
            background-color: #fff3d6;
            font-family: Arial;
            text-align: center;
            padding-top: 40px;
        }

        .box {
            width: 500px;
            margin: auto;
            padding: 25px;
            background-color: white;
            border: 3px solid orange;
            border-radius: 15px;
            box-shadow: 0 0 15px orange;
        }

        h1 {
            color: #e65100;
            animation: bounce 2s infinite;
        }

        h2 {
            color: #1565c0;
        }

        img {
            width: 220px;
            height: 220px;
            animation: move 2s infinite alternate;
        }

        .symbols {
            font-size: 35px;
            margin: 15px;
            animation: move 2s infinite alternate;
        }

        .text {
            font-size: 17px;
            color: #333;
            line-height: 1.5;
        }

        button {
            background-color: orange;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 20px;
        }

        @keyframes bounce {
            0% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }

            100% {
                transform: translateY(0);
            }
        }

        @keyframes move {
            from {
                transform: translateY(0);
            }

            to {
                transform: translateY(-15px);
            }
        }
    </style>
</head>

<body>

    <div class="box">

        <div class="symbols">🪔 🕉️ 🐄</div>

        <h1>🙏 Jai Shree Krishna 🙏</h1>

        <p>Celebrating the divine birth of Lord Krishna</p>

        <img src="./images.jpg"
             alt="Lord Krishna">

        <h2>💙 Happy Janmashtami 💙</h2>

        <p class="text">
            May Lord Krishna fill your life with
            happiness, peace and love.
            May his blessings always be with you.
        </p>

        <div class="symbols">✨ 🪔 ✨</div>

        <button>Radhe Radhe</button>

    </div>

</body>
</html>
